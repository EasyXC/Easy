<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 风格列表卡片 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_light"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:rippleColor="#14007AFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="28dp">

            <View
                android:id="@+id/ivStatus"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Demo Item | Sample" />

            <TextView
                android:id="@+id/tvTag"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="8dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:background="@drawable/bg_tag_chip"
                tools:text="示例" />

            <ImageView
                android:id="@+id/ivFavorite"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:padding="10dp"
                android:contentDescription="收藏"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/btn_star" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="14dp"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="这是一个示例描述文字" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:minHeight="36dp">

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_share"
                android:contentDescription="分享"
                android:padding="6dp"
                app:tint="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnView"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="60dp"
                android:text="查看"
                android:textColor="@color/brand_primary"
                app:strokeColor="@color/brand_primary"
                app:cornerRadius="8dp"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopy"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="60dp"
                android:layout_marginStart="8dp"
                android:text="复制"
                android:textColor="@color/white"
                android:backgroundTint="@color/brand_primary"
                app:cornerRadius="8dp"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>